# Copia este archivo a .env.local y rellena los valores.
# .env.local esta en .gitignore y nunca debe subirse al repositorio.

# --- Supabase ---------------------------------------------------------------
# Panel de Supabase > Project Settings > API
# Estas dos se envian al navegador: son publicas por diseno y estan protegidas
# por Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salta todas las politicas de RLS. Solo en servidor, nunca con prefijo
# NEXT_PUBLIC_ y nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Servicio de reconocimiento --------------------------------------------
# Microservicio Python (FastAPI) desplegado en Render u otro host con Docker.
# En local: http://127.0.0.1:8000  |  En Vercel: https://TU-SERVICIO.onrender.com
RECOGNITION_SERVICE_URL=http://localhost:8000
# Secreto compartido (el mismo valor en Render y en Vercel).
RECOGNITION_SERVICE_TOKEN=

# Motor de escaneo (opcional; sin definir = local gratis):
# - local  = integrado en Vercel (defecto)
# - auto   = Python si responde; si no, local
# - python = solo OpenCV externo
# SCAN_ENGINE=local

# --- Vision API V10.7 (Python en Vercel, /api/vision/*) ---------------------
# En local: arranca uvicorn y apunta aqui para que next dev reenvie /api/vision/*
# VISION_API_URL=http://127.0.0.1:8000
# En produccion (Vercel), recomendado si usas Supabase Storage:
# VISION_ALLOWED_IMAGE_HOSTS=tu-proyecto.supabase.co
# VISION_MAX_REFERENCES=50
# VISION_MAX_SCAN_BYTES=4400000
