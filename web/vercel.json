{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 3008
    }
  },
  "rewrites": [
    {
      "source": "/api/vision",
      "destination": "/api/index"
    },
    {
      "source": "/api/vision/(.*)",
      "destination": "/api/index"
    }
  ]
}
